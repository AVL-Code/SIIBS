# SIIBS Environment Configuration Example (11-tech-spec.md §7)
# Copy this file to .env and adjust values for local operation. Never commit .env!

NODE_ENV=development
PORT=3000

# PostgreSQL 16+ Connection Strings
DATABASE_URL=postgresql://siibs:siibs_dev_password@localhost:5432/siibs_dev
TEST_DATABASE_URL=postgresql://siibs_test:siibs_test_password@localhost:5433/siibs_test

# Docker Compose PostgreSQL Container Variables
POSTGRES_USER=siibs
POSTGRES_PASSWORD=siibs_dev_password
POSTGRES_DB=siibs_dev
POSTGRES_PORT=5432

POSTGRES_TEST_USER=siibs_test
POSTGRES_TEST_PASSWORD=siibs_test_password
POSTGRES_TEST_DB=siibs_test
POSTGRES_TEST_PORT=5433

# Authentication & Session Security (HttpOnly Cookie signing secret, min 32 chars)
SESSION_SECRET=change-this-session-secret-to-at-least-32-chars

# Protected Local File Storage & Backup Directories (RNF-05, RNF-06, RNF-10)
STORAGE_DIR=./storage/documents
BACKUP_TARGET_DIR=./storage/backups
